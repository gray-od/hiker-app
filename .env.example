# Environment variables for ProHikes.
# This file contains variable NAMES only — no values.
# Copy it to .env.local, fill in your own values, and never commit real keys or secrets.

# Supabase — required. Find the URL and anon key in your project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Required by the account deletion and password recovery endpoints.
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant — server-side keys for the built-in providers.
# Without a Google key, users can still provide their own AI key in Settings.
GOOGLE_GENERATIVE_AI_API_KEY=
# Enables the web search tool inside the AI chat.
EXA_API_KEY=

# Optional integrations — leave empty to hide the related feature.
# Donation link shown in the app.
NEXT_PUBLIC_DONATE_URL=
# Plausible analytics domain. Leave empty to disable the analytics script.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
